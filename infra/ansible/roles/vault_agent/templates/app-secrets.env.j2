{# Consul-template syntax, rendered by vault-agent into tmpfs at /run/secrets. #}
{# This file is NOT rendered by Ansible — Ansible only installs the template.  #}
{# Ansible therefore never sees the secret values, which is the whole point.   #}

{% raw %}
{{- with secret "database/creds/{% endraw %}{{ vault_db_role }}{% raw %}" }}
DB_USERNAME={{ .Data.username }}
DB_PASSWORD={{ .Data.password }}
{{- end }}

{{- with secret "kv/data/{% endraw %}{{ environment_name }}/{{ app_name }}{% raw %}" }}
OIDC_CLIENT_SECRET={{ .Data.data.oidc_client_secret }}
ENCRYPTION_KEY_ID={{ .Data.data.encryption_key_id }}
S3_ACCESS_KEY={{ .Data.data.s3_access_key }}
S3_SECRET_KEY={{ .Data.data.s3_secret_key }}
{{- end }}
{% endraw %}
