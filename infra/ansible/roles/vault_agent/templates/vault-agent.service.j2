# Managed by Ansible — roles/vault_agent
[Unit]
Description=HashiCorp Vault Agent
Documentation=https://developer.hashicorp.com/vault/docs/agent
After=network-online.target
Wants=network-online.target
# The application requires this unit — if secrets cannot be rendered, the app
# must not start with stale or missing credentials.
Before={{ app_name | default('app') }}.service

[Service]
Type=simple
User=vault-agent
Group=vault-agent

ExecStart=/usr/local/bin/vault agent -config=/etc/vault-agent/agent.hcl
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGINT

Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=IPC_LOCK
AmbientCapabilities=IPC_LOCK
# Prevent the memory holding tokens from being swapped to disk.
LimitMEMLOCK=infinity
ReadWritePaths=/run/secrets /run

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vault-agent

[Install]
WantedBy=multi-user.target
