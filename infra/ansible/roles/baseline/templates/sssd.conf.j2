# Managed by Ansible — roles/baseline
# Central identity. No local user accounts on managed hosts: offboarding must be
# a single action in the directory, not a fleet-wide grep.
[sssd]
domains = {{ sssd_domain }}
services = nss, pam, ssh, sudo
config_file_version = 2

[nss]
filter_users = root
override_shell = /bin/bash

[pam]
offline_credentials_expiration = 1

[sudo]

[ssh]

[domain/{{ sssd_domain }}]
id_provider = ldap
auth_provider = ldap
sudo_provider = ldap
ldap_uri = {{ sssd_ldap_uri }}
ldap_search_base = dc={{ sssd_domain.split('.') | join(',dc=') }}
ldap_id_use_start_tls = True
ldap_tls_reqcert = demand
ldap_tls_cacert = /etc/pki/tls/certs/bank-internal-ca.pem
cache_credentials = True
enumerate = False

# Only these directory groups may log in at all.
access_provider = simple
simple_allow_groups = {{ ssh_allow_groups.split() | join(', ') }}
