#
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit
# it. This file only documents which variables exist and their defaults.
#
#   cp .env.example .env

# --- Postgres ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=changeme-strong-password
REDIS_PORT=6379

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-strong-password
KEYCLOAK_PORT=8080
